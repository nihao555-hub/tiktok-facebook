# ============================================================================
#  复制为 .env 并填入你自己的 key。
#  不填也能跑通最小流水线（local 占位素材 + edge-tts + whisper 字幕 + ffmpeg 混剪）。
#  线上推荐组合：grsai(gpt-5.5 文案 + gpt-image-2 出图) + wuyinkeji(图生视频) + ElevenLabs(配音)
# ============================================================================

# ---------- 文案 LLM (OpenAI 兼容) ----------
# grsai: LLM_BASE_URL=https://grsaiapi.com/v1 ，模型如 gpt-5.5 / gemini-3.1-pro
LLM_API_KEY=
LLM_BASE_URL=https://grsaiapi.com/v1
LLM_MODEL=gpt-5.5

# ---------- 文生图 / 图生图: grsai gpt-image-2 ----------
# 强约束输出超写实；用 media/refs 里的真实商品/工厂图做图生图，保证商品一致
IMAGE_PROVIDER=grsai
GRSAI_API_KEY=                         # 不填则复用 LLM_API_KEY（同一个 grsai key）
GRSAI_BASE_URL=https://grsaiapi.com
IMAGE_MODEL=gpt-image-2

# ---------- AI 片段生成 ----------
# provider 可选: local | wuyinkeji | replicate | kling | openai_video | runway
# wuyinkeji = gpt-image-2 出图 -> 无垠 video_google_omni 图生视频（默认线上链路）
CLIPGEN_PROVIDER=wuyinkeji
CLIPGEN_API_KEY=
CLIPGEN_BASE_URL=
CLIPGEN_MODEL=
# 无垠科技 视频生成
WUYIN_API_KEY=
WUYIN_BASE_URL=https://api.wuyinkeji.com
WUYIN_ENDPOINT=video_google_omni

# ---------- 配音 TTS ----------
# provider 可选: edge(默认,免key) | elevenlabs | openai | azure
TTS_PROVIDER=elevenlabs
TTS_VOICE=FGY2WhTYpPnrIDTdsKH5         # ElevenLabs voice id（默认 Laura，社媒带货感）
TTS_MODEL=eleven_multilingual_v2      # 泰语/中文等非英语请改 eleven_v3（唯一支持泰语 th 的模型）
TTS_API_KEY=
TTS_BASE_URL=
AZURE_TTS_REGION=

# ---------- 发布: 暂不自动发布（按需开启）----------
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=v21.0
