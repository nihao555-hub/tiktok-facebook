# ============================================================================
#  复制为 .env 并填入你自己的 key。所有 key 都是可选的：
#  不填也能跑通最小流水线（本地素材 + edge-tts 配音 + whisper 字幕 + ffmpeg 混剪）。
# ============================================================================

# ---------- 文案 LLM (OpenAI 兼容；留空则用模板文案) ----------
# 兼容 OpenAI / DeepSeek / 通义千问 / 豆包 / Gemini(OpenAI-compat) 等
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------- AI 片段生成 (图生视频 / 文生视频；留空则只用 media/clips 里的本地素材) ----------
# provider 可选: local | replicate | kling | openai_video | runway （见 pipeline/providers/clipgen.py）
CLIPGEN_PROVIDER=local
CLIPGEN_API_KEY=
CLIPGEN_BASE_URL=
CLIPGEN_MODEL=

# ---------- 配音 TTS ----------
# provider 可选: edge(默认,免key) | openai | azure | elevenlabs
TTS_PROVIDER=edge
TTS_VOICE=en-US-AriaNeural
# openai / elevenlabs / azure 用到的 key（按所选 provider 填）
TTS_API_KEY=
TTS_BASE_URL=
AZURE_TTS_REGION=

# ---------- 发布: TikTok (Content Posting API) ----------
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ---------- 发布: Facebook (Graph API) ----------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=v21.0
